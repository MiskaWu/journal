#!/usr/bin/env python3
"""journal-console —— 控制台的常駐靜態伺服器（2026-08-31）。

console/index.html 是零後端頁面（瀏覽器直連 GitHub API），這支只負責把它
掛在固定網址上。要常駐的實際理由是 PAT：它存在 localStorage，而 localStorage
跟著 origin 走——file:// 與臨時 port 每換一次入口就得重貼一次 token，
固定的 http://127.0.0.1:8899/ 才是 token 的家。

只綁 127.0.0.1。仍驗 Host 標頭（擋 DNS rebinding：外部網頁把自家網域解析到
127.0.0.1 後，瀏覽器會帶著該網域的 Host 對本機發請求；這頁雖無 API 可打，
擋掉是衛生習慣，與 taskwire task-ui 同一套規矩）。

安裝／移除走 journal init --console / --no-console，不要手動 cp unit
（腳印要進 common.sh 的清單，見 D20）。埠號用環境變數 JOURNAL_CONSOLE_PORT
覆寫，預設 8899。
"""

import os
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

ROOT = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'console')
PORT = int(os.environ.get('JOURNAL_CONSOLE_PORT', '8899'))
ALLOWED_HOSTS = {'127.0.0.1', 'localhost', '[::1]'}


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def _host_ok(self):
        host = self.headers.get('Host', '')
        if host.startswith('['):
            host = host.split(']')[0] + ']'
        else:
            host = host.split(':')[0]
        if host not in ALLOWED_HOSTS:
            self.send_error(403, 'Host not allowed')
            return False
        return True

    def do_GET(self):
        if self._host_ok():
            super().do_GET()

    def do_HEAD(self):
        if self._host_ok():
            super().do_HEAD()

    def log_message(self, fmt, *args):
        pass  # 常駐服務不灑 access log（D17 同一精神：背景路徑保持安靜）


def main():
    if not os.path.isdir(ROOT):
        print(f'journal-console: 找不到 console 目錄：{ROOT}', file=sys.stderr)
        return 1
    srv = ThreadingHTTPServer(('127.0.0.1', PORT), Handler)
    print(f'journal-console: http://127.0.0.1:{PORT}/ （root={ROOT}）', flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
